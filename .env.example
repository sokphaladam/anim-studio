# Which AI backend to use: "ollama" (default, local) or "openai-compatible" (cloud fallback). Used from Milestone 3.
AI_PROVIDER=ollama
# Ollama server URL and model.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b
# pnpm dev installs/starts Ollama if missing and the server downloads OLLAMA_MODEL in the background. Set to 0 to manage Ollama yourself.
OLLAMA_AUTO_SETUP=1
# OpenAI-compatible cloud AI (Gemini, Groq, ...). FALLBACK_MODEL may list several models, comma-separated: a busy one is skipped.
# Gemini: FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/ with a key from aistudio.google.com.
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=
# 1 = keep Ollama first, but use the FALLBACK_* cloud model while Ollama isn't running or its model is missing. Off by default: prompts stay local.
AI_FALLBACK=0
# SQLite file for projects and their version history (default: data/anim-studio.db).
DB_PATH=
# Folder for exported MP4s (default: data/exports, beside the database).
EXPORTS_DIR=
# Port of the local API server (the web app proxies /api to it).
API_PORT=8790
# Folder of diffusers models for pnpm setup:painter; the Flat 2D motion graphics style paints with stable-diffusion-xl-base-1.0 from it.
DIFFUSERS_DIR=E:/ShortStudio/models
# Cloud video (opt-in; off by default). With CLOUD_VIDEO_ENABLED=1 and a key, cinematic AI shots and AI > Turn the painting
# into video use Runway instead of the local Wan model. The key stays in the server process. Models: seedance2_5 or kling_4.
# Price (list, 720p): seedance2_5 about $0.30 a second ($0.80 minimum), kling_4 about $0.16 a second; the app quotes it first.
CLOUD_VIDEO_ENABLED=0
RUNWAY_API_KEY=
RUNWAY_VIDEO_MODEL=seedance2_5
# Cloud spend limit for one job (all its cinematic shots and retries); a shot priced over what is left is never started.
RUNWAY_MAX_COST_USD=5.00
# Extra tries for a cinematic shot that fails or fails its checks (cloud or local); after that it is marked for review.
RUNWAY_MAX_RETRIES=1
