{
  "name": "anim-studio",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "predev": "node scripts/setup-ai.mjs --no-pull",
    "dev": "pnpm --parallel --filter @anim/web --filter @anim/server dev",
    "build": "pnpm -r build",
    "desktop": "node scripts/setup-ai.mjs --no-pull && pnpm --parallel --filter @anim/web --filter @anim/server --filter @anim/desktop dev",
    "desktop:build": "pnpm --filter @anim/desktop dist",
    "setup:ai": "node scripts/setup-ai.mjs",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "storybook": "pnpm --filter @anim/ui storybook",
    "screenshots": "node scripts/screenshots.mjs",
    "compare": "node scripts/compare-reference.mjs",
    "e2e:flipbook": "node scripts/flipbook-e2e.mjs",
    "e2e:lofi": "node scripts/lofi-draw-e2e.mjs",
    "generate:layered": "pnpm --filter @anim/server exec tsx src/layered-cli.ts",
    "setup:painter": "node scripts/setup-painter.mjs",
    "e2e:layered": "node scripts/layered-e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^22",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
