# Which AI backend to use: "ollama" (default, local) or "openai-compatible" (cloud fallback). Used from Milestone 3.
AI_PROVIDER=ollama
# Ollama server URL and model.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b
# Optional OpenAI-compatible fallback (Gemini, Groq, ...).
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=
# Port of the local API server (the web app proxies /api to it).
API_PORT=8790
