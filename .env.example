# Which AI backend to use: "ollama" (default, local) or "openai-compatible" (cloud fallback). Used from Milestone 3.
AI_PROVIDER=ollama
# Ollama server URL and model.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b
# pnpm dev installs/starts Ollama if missing and the server downloads OLLAMA_MODEL in the background. Set to 0 to manage Ollama yourself.
OLLAMA_AUTO_SETUP=1
# OpenAI-compatible cloud AI (Gemini, Groq, ...). FALLBACK_MODEL may list several models, comma-separated: a busy one is skipped.
# Gemini: FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/ with a key from aistudio.google.com.
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=
# SQLite file for projects and their version history (default: data/anim-studio.db).
DB_PATH=
# Port of the local API server (the web app proxies /api to it).
API_PORT=8790
# Folder of diffusers models for pnpm setup:painter; the Flat 2D motion graphics style paints with stable-diffusion-xl-base-1.0 from it.
DIFFUSERS_DIR=E:/ShortStudio/models
