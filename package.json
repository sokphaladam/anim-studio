{
  "name": "anim-studio",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "predev": "node scripts/setup-ai.mjs --no-pull",
    "dev": "node scripts/dev.mjs @anim/web @anim/server",
    "build": "npm run build --workspaces --if-present",
    "desktop": "node scripts/setup-ai.mjs --no-pull && node scripts/dev.mjs @anim/web @anim/server @anim/desktop",
    "desktop:build": "npm run dist -w @anim/desktop",
    "setup:ai": "node scripts/setup-ai.mjs",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "storybook": "npm run storybook -w @anim/ui",
    "screenshots": "node scripts/screenshots.mjs",
    "compare": "node scripts/compare-reference.mjs",
    "e2e:flipbook": "node scripts/flipbook-e2e.mjs",
    "e2e:lofi": "node scripts/lofi-draw-e2e.mjs",
    "generate:layered": "npm exec -w @anim/server -- tsx src/layered-cli.ts",
    "samples:styles": "npm exec -w @anim/server -- tsx src/style-samples.ts",
    "setup:painter":"node scripts/setup-painter.mjs",
    "e2e:layered": "node scripts/layered-e2e.mjs"
  },
  "devDependencies": {
    "@types/node": "^22",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
