# Anim Studio settings. Copy to .env (npm run bootstrap does it for you).
# Most of these can be changed in the app instead: the gear button > Settings saves them here.

# ── Language model (plans scenes) ────────────────────────────────────────────
# "ollama" = local model on this computer, "openai-compatible" = cloud model below (e.g. Gemini).
AI_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
# Empty = the largest model this computer can run (picked at start).
OLLAMA_MODEL=
# 1 = npm run dev installs/starts Ollama and downloads OLLAMA_MODEL. 0 = you manage Ollama yourself.
OLLAMA_AUTO_SETUP=1

# ── Cloud language model (Gemini, Groq, ...) ────────────────────────────────
# Easiest: paste a Gemini key in Settings. Key: aistudio.google.com/apikey
# FALLBACK_MODEL may list several models, comma-separated: a busy one is skipped.
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=
# 1 = stay local, but use the cloud model while Ollama isn't running. 0 = prompts never leave this computer.
AI_FALLBACK=0

# ── Painter + local video (ComfyUI) ─────────────────────────────────────────
# Install from Settings > Downloads, or: npm run setup:painter [--layered] [--video]
# COMFY_URL can point at ComfyUI on another PC (started with --listen).
COMFY_URL=http://127.0.0.1:8188
# Painting model file in ComfyUI/models/checkpoints (an SDXL checkpoint).
PAINT_CHECKPOINT=animagine-xl-4.0-opt.safetensors
# Wan video weights: fp8_e4m3fn (less memory) or default (fp16, better quality).
VIDEO_WEIGHTS=fp8_e4m3fn

# ── Cloud video (Runway, opt-in, paid) ──────────────────────────────────────
# 1 = AI video uses Runway instead of the local Wan model. The key never leaves the server.
# Models: seedance2_5 (about $0.30/s, $0.80 minimum) or kling_4 (about $0.16/s); the app shows the price first.
CLOUD_VIDEO_ENABLED=0
RUNWAY_API_KEY=
RUNWAY_VIDEO_MODEL=seedance2_5
# Spend limit for one job (all its shots and retries), in USD.
RUNWAY_MAX_COST_USD=5.00
# Extra tries for a video shot that fails its checks (cloud or local).
RUNWAY_MAX_RETRIES=1

# ── Server ──────────────────────────────────────────────────────────────────
# Port of the local API server (the web app talks to it).
API_PORT=8790

# ── Optional (uncomment to change the default) ──────────────────────────────
# Projects database (default: data/anim-studio.db)
# DB_PATH=
# Exported MP4s (default: data/exports)
# EXPORTS_DIR=
# Where ComfyUI is installed (default: data/comfyui)
# COMFY_DIR=
# Put Wan's text encoder + VAE on another drive
# VIDEO_MODELS_DIR=
# 0 = turn off the fast 4-step video LoRA (slower, sometimes cleaner)
# VIDEO_TURBO=0
